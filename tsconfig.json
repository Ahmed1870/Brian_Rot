{
  "compilerOptions": {
    "target": "ES2020", "module": "ESNext", "moduleResolution": "Bundler", "jsx": "react-jsx",
    "lib": ["DOM", "ES2020"], "strict": true, "noEmit": true, "skipLibCheck": true,
    "esModuleInterop": true, "isolatedModules": true, "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
