{
  "name": "monzoma-incomplete-truth-18s",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "generate-audio": "node scripts/generate-audio.cjs",
    "dev": "remotion studio src/index.ts",
    "render": "remotion render src/index.ts BrainRotViral out/BrainRotViral.mp4 --codec=h264 --crf=16",
    "build": "node scripts/generate-audio.cjs && remotion render src/index.ts BrainRotViral out/BrainRotViral.mp4 --codec=h264 --crf=16",
    "still": "remotion still src/index.ts BrainRotViral out/frame.png --frame=240",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.0",
    "@remotion/google-fonts": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "typescript": "^5.5.0"
  }
}
